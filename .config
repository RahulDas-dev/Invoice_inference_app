# Logging configuration ...
LOG_LEVEL=INFO
# LOG_FILE=

# Deployment configuration ...
DEPLOYMENT_ENV=PRODUCTION
HOST=127.0.0.1
PORT=5005
API_VERSION=1.0.0
TIMEZONE=UTC
LANGUAGE=en-US
APPLICATION_NAME=Invoice-Inference
