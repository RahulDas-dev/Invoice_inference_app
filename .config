MAX_CONCURRENT_REQUEST=5
IMAGE_TO_TEXT_MODEL=us.meta.llama4-maverick-17b-instruct-v1:0
PAGE_GROUPPER_MODEL=o4-mini-2025-04-16
OUTPUT_FORMATOR_MODEL=gpt-4o-mini